# ==============================================================================
# Competitive Intelligence Monitoring Platform - Production & Environment Config
# ==============================================================================

# --- Application Environment ---
# Options: development, staging, production, test
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
PROJECT_NAME="Competitive Intelligence Agent"
API_V1_STR=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed origins or JSON array format
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Relational Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/competitive_intelligence
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Vector Database (Qdrant) ---
# In Docker Compose, the service hostname is 'qdrant'
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ci_knowledge_chunks
QDRANT_TIMEOUT=10
# Set to :memory: ONLY in local unit tests. Forbidden in production/staging.
# QDRANT_LOCATION=

# --- Embeddings & Dense Retrieval ---
# Options: bge_m3 (production default, 1024-dim), mock (testing only)
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- LLM & Analytical Reasoning ---
# Options: openai, anthropic (mock is strictly forbidden in production)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0

# --- LLM Call & Task Budget Controls ---
MAX_LLM_CALLS_PER_TASK=10
MAX_RETRIEVAL_HOPS=3
TASK_TOKEN_BUDGET=30000

# --- Continuous Monitoring & Scheduler ---
MONITORING_ENABLED=true
# Options: in_process, worker, disabled
MONITORING_MODE=in_process
MONITORING_POLL_INTERVAL_SECONDS=15.0
MONITORING_BATCH_SIZE=10
MONITORING_MAX_CONCURRENCY=5
MONITORING_LEASE_TIMEOUT_SECONDS=300
MONITORING_HEARTBEAT_INTERVAL_SECONDS=60

# --- Web Acquisition & Crawling ---
CRAWL4AI_HEADLESS=true
AGENT_REACH_API_KEY=
